

import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from flask import Flask, request, jsonify
import pickle
import os

file = "data.csv"

df = pd.read_csv(file)

print("✅ Data Loaded")
print("Columns:", df.columns)



df = df.select_dtypes(include=['number'])


df = df.dropna()

print("✅ Cleaned Data:")
print(df.head())


X = df[['age']]
y = df['salary']

model = LinearRegression()
model.fit(X, y)

print("✅ Model Trained")

with open("model.pkl", "wb") as f:
    pickle.dump(model, f)

plt.scatter(X, y)
plt.plot(X, model.predict(X))
plt.title("Age vs Salary")
plt.xlabel("Age")
plt.ylabel("Salary")
plt.show()

app = Flask(__name__)

@app.route("/")
def home():
    return "🚀 API Running!"

@app.route("/predict", methods=["POST"])
def predict():
    data = request.get_json()

    value = float(data["age"])   # now using 'age'
    prediction = model.predict([[value]])

    return jsonify({
        "age": value,
        "predicted_salary": float(prediction[0])
    })

if __name__ == "__main__":
    print("🌐 Starting API...")
    app.run(debug=True)
